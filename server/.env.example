NODE_ENV=development
PORT=5000

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

FRONTEND_URL=http://localhost:5173

# Email Service (Nodemailer for password resets)
# For Gmail: Use a 16-character Google App Password (from https://myaccount.google.com/apppasswords)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM="URxpenz Finance <your-email@gmail.com>"

# Or for Custom SMTP (Brevo, SendGrid, Mailgun, AWS SES):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@urxpenz.app
